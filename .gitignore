node_modules

**/node_modules/
**/dist
**/build
# Turborepo daemon logs and local cache (build output, not source)
.turbo/
**/.turbo/

# Local Docker deployment secrets
.env.docker

# Local git worktree checkouts (working copies, not source)
.worktrees/

# Local project context; keep the reusable feature template versioned.
/context/*.md
/context/**/*.md
!/context/project-overview.md
!/context/coding-standards.md
!/context/model-selection.md
!/context/feature-history.md
!/context/features/feature-template.md

# Non-markdown feature artifacts (e.g. visual-regression baseline screenshots)
# are local context too; only the docs above are project assets.
/context/features/**/baseline/

# Local MCP server config; contains API keys.
/.mcp.json

# Skills installed locally by ui-ux-pro-max-cli; not project assets.
# The repo's own skills (cleanup, feature, list-components) stay versioned.
/.claude/skills/banner-design/
/.claude/skills/brand/
/.claude/skills/design/
/.claude/skills/design-system/
/.claude/skills/slides/
/.claude/skills/ui-styling/
/.claude/skills/ui-ux-pro-max/

# Skills installed locally by the `skills` CLI (npx skills add); not project assets.
/.agents/
/skills-lock.json
/.claude/skills/apollo-server/
/.claude/skills/find-skills/
/.claude/skills/graphql-schema/
/.claude/skills/nestjs-best-practices/
/.claude/skills/prisma-cli/
/.claude/skills/prisma-client-api/
/.claude/skills/shadcn/
/.claude/skills/tailwind-4-docs/
/.claude/skills/vercel-react-best-practices/

# Deployment backups written by scripts/deploy.sh
/backups/


# Scratch space for local audits and throwaway databases.
/.tmp/

# Browser artifacts written by the Playwright MCP server.
/.playwright-mcp/
