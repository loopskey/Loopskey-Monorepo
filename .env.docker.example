# Loopskey — Docker deployment template
#
# Copy to `.env.docker` and fill in. `.env.docker` is gitignored and holds the
# real secrets; this file is the versioned contract of what a deployment needs.
#
# `compose.production.yaml` sets NODE_ENV, APP_HOST, APP_PORT, GRAPHQL_PLAYGROUND,
# FRONTEND_URL, APPLICATION_BASE_URL, the upload directories, and the
# organization/association URLs itself. A value for any of those placed here is
# ignored, so they are deliberately absent.

# --------------------------------------------------------------------- images
# Blank uses the locally built image. Point these at the registry to deploy
# without building on the server.
API_IMAGE=
FRONT_IMAGE=

# ------------------------------------------------------------------- database
POSTGRES_DB=loopskey
POSTGRES_USER=loopskey
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------- public origins
# The frontend origin, without a trailing slash. Every activation and login link
# in outgoing mail is built from it.
PUBLIC_FRONTEND_URL=https://www.example.com

# Baked into the frontend bundle at build time. Rebuild the frontend image after
# changing it.
NEXT_PUBLIC_GRAPHQL_URL=https://api.example.com/graphql

# The frontend also uses PUBLIC_FRONTEND_URL above as its canonical public
# origin: compose.production.yaml passes it as NEXT_PUBLIC_SITE_URL, so the
# canonical, Open Graph and social-card URLs and the activation links in mail
# cannot drift apart. It must be an https origin on the public hostname with no
# path, and the frontend image must be rebuilt after changing it.

# Indexing and configuration policy, separate from NODE_ENV so a production
# build served as staging stays unindexable. One of development, ci, preview,
# staging or production; anything other than production emits noindex for every
# route and a disallow-all robots.txt. Read at build time, so promote a staging
# image to production by rebuilding it, never by relabelling it. When unset,
# the Docker build and compose.production.yaml default to staging (unindexable),
# so a forgotten value fails safe; set production explicitly for the live site.
DEPLOYMENT_ENV=production

# Optional. Comma-separated bare hosts redirected to the canonical origin, for
# example the apex host when PUBLIC_FRONTEND_URL is the www host. Only these
# hosts are normalized; an unknown Host never reaches a canonical URL.
SITE_CANONICAL_HOST_ALIASES=

# Optional. true only when the TLS-terminating reverse proxy sets
# x-forwarded-proto and does not already redirect http itself. See the
# reverse-proxy section of the README before enabling it.
SITE_HTTPS_REDIRECT=false

# Optional. The REST origin for avatar/evidence/logo/report clients. Falls
# back to the origin of NEXT_PUBLIC_GRAPHQL_URL above when unset, so this only
# needs a value when REST and GraphQL are served from different origins.
NEXT_PUBLIC_API_URL=

# Comma-separated browser origins allowed to call the API with credentials. List
# every hostname the frontend is reachable on: serving both the apex and the www
# host while allowing only www fails every request from the apex.
CORS_ORIGIN=https://www.example.com,https://example.com

# ---------------------------------------------------------- published ports
# Bound to 127.0.0.1 only. A TLS reverse proxy is expected in front.
FRONT_PORT=3000
API_PORT=5700
DB_PORT=5432

# ------------------------------------------------------------------ secrets
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET_KEY=
OAUTH_STATE_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# -------------------------------------------------------------------- cookies
# ACCESS_TOKEN_COOKIE_NAME must match between the API and the frontend. Blank
# uses the shared default from @loopskey/api-contracts.
ACCESS_TOKEN_COOKIE_NAME=
REFRESH_TOKEN_COOKIE_NAME=
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Leading dot shares the cookie with every subdomain.
COOKIE_DOMAIN=.example.com

# ------------------------------------------------------------------ identity
APP_NAME=LoopsKey
SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------------- email
RESEND_API_KEY=
EMAIL_FROM=LoopsKey <no-reply@example.com>
CONTACT_RECIPIENT_EMAIL=support@example.com

# ------------------------------------------------------------------------ otp
OTP_LENGTH=6
OTP_CODE_CHARSET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=12

# ----------------------------------------------------- account activation
ACTIVATION_TOKEN_EXPIRY_MINUTES=60
ACTIVATION_RESEND_COOLDOWN_SECONDS=120
ACTIVATION_MAX_RESENDS_PER_DAY=5

# -------------------------------------------------------------- oauth: google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback
GOOGLE_CALENDAR_REDIRECT=https://api.example.com/calendar/google/callback

# ------------------------------------------------------------ oauth: linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://api.example.com/auth/linkedin/callback

# -------------------------------------------------------------- oauth: shared
OAUTH_REDIRECT_URL=https://www.example.com/auth/oauth/bridge
OAUTH_STATE_COOKIE_NAME=oauth_state

# ------------------------------------------------------- roadmap ai service
# Base origin including the port, without a trailing slash, for example
# https://api.sindexx.lol:8443. It is used exactly as written, so the port is
# never dropped. https is required when NODE_ENV=production. Leave blank and
# the API still boots: startup logs an error and every roadmap AI call fails at
# once as unavailable, without retrying.
ROADMAP_AI_BASE_URL=
ROADMAP_AI_SERVICE_TOKEN=

# Blank uses the defaults (35000ms chat turn, 80000ms generation). A value must
# exceed 30000ms for a chat turn and 75000ms for a generation, otherwise the
# call is cancelled while the provider would still have answered and the API
# refuses to boot.
ROADMAP_AI_CHAT_TURN_TIMEOUT_MS=
ROADMAP_AI_GENERATE_TIMEOUT_MS=

# ---------------------------------------------------------------- reliability
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=90000
REPORT_EXPIRY_SWEEP_MS=3600000
