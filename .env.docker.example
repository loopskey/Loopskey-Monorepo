# Copy this file to .env.docker and replace every change-me value.
POSTGRES_DB=loopskey
POSTGRES_USER=loopskey
POSTGRES_PASSWORD=change-me-database-password

JWT_ACCESS_SECRET=change-me-use-a-long-random-value
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-value
SESSION_SECRET_KEY=change-me-use-another-long-random-value
SERVICE_AI_API_KEY=change-me-use-a-service-key

# Browser-visible URLs. Change these to the deployed HTTPS domains in production.
PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5700/graphql
FRONT_PORT=3000
API_PORT=5700

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
GRAPHQL_PLAYGROUND=false

# Optional email delivery configuration.
SUPPORT_EMAIL=support@example.com
RESEND_API_KEY=
EMAIL_FROM=LoopsKey <notifications@example.com>
