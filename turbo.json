{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["BACKEND_URL", "SESSION_SECRET_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "front#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "NEXT_PUBLIC_*",
        "DEPLOYMENT_ENV",
        "SITE_CANONICAL_HOST_ALIASES",
        "SITE_HTTPS_REDIRECT"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "front#codegen": {
      "inputs": [
        "src/lib/graphql/documents/**/*.graphql",
        "codegen.ts",
        "../api/src/graphql/schema.gql"
      ],
      "outputs": ["src/lib/graphql/generated.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
