{
  "cSpell.customDictionaries": {
    "custom-dictionary-workspace": {
      "name": "custom-dictionary-workspace",
      "path": "${workspaceFolder:Monorepo}/.cspell/custom-dictionary-workspace.txt",
      "addWords": true,
      "scope": "workspace"
    }
  },
  "cSpell.words": ["COURSEREVIEW", "COUSREREVIEW", "pocdast", "Podcastdetail"],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.git/objects/**": true,
    "**/.turbo/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/package-lock.json": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/dist": true,
    "**/coverage": true
  },
  "typescript.tsserver.watchOptions": {
    "watchDirectory": "useFsEvents",
    "excludeDirectories": ["**/node_modules", "**/.next", "**/dist"]
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.disableAutomaticTypeAcquisition": true
}
