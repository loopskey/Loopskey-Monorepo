# Loopskey AI service — sanitized example. Copy to .env and fill in locally.
# Never commit a real .env or paste its values into code, logs or screenshots.

# development | test | production
SERVICE_AI_ENVIRONMENT=development
SERVICE_AI_LOG_LEVEL=INFO

# Private bind address. This service is not a public origin: only apps/api
# calls it, so it must not be exposed on a public interface.
SERVICE_AI_HOST=127.0.0.1
SERVICE_AI_PORT=5800

# Shared credential apps/api presents on every /v1 request.
# Optional in development; required in every other environment.
SERVICE_AI_API_KEY=

# Where deferred results are posted back once work completes.
SERVICE_AI_CORE_API_URL=http://127.0.0.1:5700

# Outbound call budget in seconds for model providers and callbacks.
SERVICE_AI_REQUEST_TIMEOUT_SECONDS=60
