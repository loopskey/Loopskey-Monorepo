# Loopskey API — environment template
#
# Copy to `.env` and fill in. Every key the application reads is listed here;
# values are placeholders or safe defaults. Never commit real secrets.

# ---------------------------------------------------------------- application
NODE_ENV=development
APP_NAME=LoopsKey
APP_HOST=localhost
APP_PORT=5700
FRONTEND_URL=http://localhost:3000
APPLICATION_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# ------------------------------------------------------------------- database
# Required. Every Prisma command fails with P1012 without it.
DATABASE_URL=

# Required. The same database over a DIRECT (non-pooled) connection, used only
# by Prisma migration commands. Through a pooler the migration engine reads an
# empty _prisma_migrations table and reports every migration as unapplied.
# On Neon this is the DATABASE_URL host without the "-pooler" suffix and without
# the pgbouncer/connection_limit/pool_timeout parameters. When Postgres is local
# and unpooled, use the same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# -------------------------------------------------------------------- graphql
GRAPHQL_PLAYGROUND=true
GRAPHQL_SCHEMA_PATH=src/graphql/schema.gql
# Comma-separated list of browser origins allowed to call the API with
# credentials. Blank falls back to FRONTEND_URL alone. List every hostname the
# frontend is actually reachable on: production served both the apex and the
# www host, only www was allowed, and every request from the apex failed CORS.
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------ jwt
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# -------------------------------------------------------------------- cookies
# ACCESS_TOKEN_COOKIE_NAME is honoured on both write and read. Leave blank to
# use the shared default from @loopskey/api-contracts. If set, apps/front must
# be given the same value.
ACCESS_TOKEN_COOKIE_NAME=
REFRESH_TOKEN_COOKIE_NAME=
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
# Must be true wherever the API is served over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------ otp
OTP_LENGTH=6
OTP_CODE_CHARSET=0123456789
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=12

# ------------------------------------- admin-provisioned account activation
ORGANIZATION_LOGIN_URL=http://localhost:3000/auth/organization
ORGANIZATION_ACTIVATION_URL=http://localhost:3000/auth/organization/activate
ASSOCIATION_LOGIN_URL=http://localhost:3000/auth/association
ASSOCIATION_ACTIVATION_URL=http://localhost:3000/auth/association/activate
ACTIVATION_TOKEN_EXPIRY_MINUTES=60
ACTIVATION_RESEND_COOLDOWN_SECONDS=120
ACTIVATION_MAX_RESENDS_PER_DAY=5

# ---------------------------------------------------------------------- email
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=LoopsKey <notifications@example.com>

# -------------------------------------------------------------------- contact
# Recipient for public Contact Us inquiries. Production value is
# loopskey.dev@gmail.com. Server-side only: never exposed to the client.
CONTACT_RECIPIENT_EMAIL=loopskey.dev@gmail.com
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
CONTACT_MAX_INQUIRIES_PER_EMAIL=3
CONTACT_MAX_INQUIRIES_PER_IP=10
CONTACT_DUPLICATE_WINDOW_MINUTES=5

# ----------------------------------------------------------- public discovery
# URLs per sitemap shard, 1 to 50000. The sitemap protocol caps a single
# sitemap at 50000 URLs; the default leaves headroom and keeps one shard small
# enough to build without unbounded memory. A value outside the range stops the
# enumeration with an error naming this variable.
PUBLIC_URL_SHARD_SIZE=10000
# Warning threshold for a public URL enumeration read. Default 500.
PUBLIC_URL_SLOW_QUERY_MS=500

# ---------------------------------------------------------------- reliability
# The outbox runs two independent pollers so a bulk producer (ingestion) can
# never delay a realtime one (mail, audit, roadmap generation, association
# notifications) — see apps/api/docs/concurrency-operations.md (Outbox).
#
# Realtime lane: mail, audit, roadmap generation, association notifications.
# How often the realtime-lane poller polls for pending deliveries.
OUTBOX_POLL_INTERVAL_MS=1000
# How long a claimed realtime-lane event stays off limits to other workers.
# Keep it above the longest normal handler call plus a safety margin: roadmap
# generation waits up to ROADMAP_AI_GENERATE_TIMEOUT_MS (150000ms) for the AI
# service, which may spend a second call repairing its output. The processor
# also renews the lease every third of this value while a handler runs, so a
# slower handler keeps its claim.
OUTBOX_LEASE_MS=180000

# Bulk lane: ingestion (crawler-driven, high-volume, delay-tolerant).
# How often the bulk-lane poller polls for pending deliveries.
OUTBOX_BULK_POLL_INTERVAL_MS=1000
# How long a claimed bulk-lane event stays off limits to other workers.
OUTBOX_BULK_LEASE_MS=60000

# ------------------------------------------------------- roadmap ai service
# The externally operated Roadmap AI Service. Leave blank and the API still
# boots: startup logs an error and every roadmap AI call fails at once as
# unavailable, without retrying, until both values are set.
# The address is used exactly as written, so keep the port: for example
# https://api.sindexx.lol:8443 (https is required when NODE_ENV=production; a
# malformed address or one with embedded credentials stops the API booting).
ROADMAP_AI_BASE_URL=
ROADMAP_AI_SERVICE_TOKEN=

# Per-operation timeouts. Each must exceed what the provider needs, or the call
# is cancelled while the provider would still have answered: more than 30000ms
# for a chat turn, more than 142000ms for a generation (70000ms per provider
# call, plus one repair call). Anything at or under those values stops the API
# booting. A reverse proxy in front of the provider must wait longer than this.
# Blank uses the defaults below.
ROADMAP_AI_CHAT_TURN_TIMEOUT_MS=35000
ROADMAP_AI_GENERATE_TIMEOUT_MS=150000

# -------------------------------------------------------------- oauth: google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_CALENDAR_REDIRECT=

# ------------------------------------------------------------ oauth: linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=

# -------------------------------------------------------------- oauth: shared
OAUTH_REDIRECT_URL=
OAUTH_STATE_SECRET=
OAUTH_STATE_COOKIE_NAME=

# -------------------------------------------------------------------- uploads
# Local disk. These directories must be writable, and persistent in any real
# deployment: the database stores only file metadata.
PDU_UPLOAD_DIR=
CERTIFICATE_UPLOAD_DIR=
AVATAR_UPLOAD_DIR=
# Generated report exports. Private: never served statically, never behind a
# CDN. The API streams these files after authorising the request.
REPORT_STORAGE_DIR=
# How often the retention sweep expires generated exports. Default 3600000.
REPORT_EXPIRY_SWEEP_MS=

# -------------------------------------------------------------------- seeding
# Development only. `npm run db:seed --workspace api`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
SEED_TEST_PASSWORD=
SEED_PROFESSIONAL_USERS=5
SEED_PROVIDER_USERS=3
SEED_ORG_USERS=3
SEED_ASSOCIATION_USERS=2
SEED_COURSES=20
