# Loopskey API — environment template
#
# Copy to `.env` and fill in. Every key the application reads is listed here;
# values are placeholders or safe defaults. Never commit real secrets.

# ---------------------------------------------------------------- application
NODE_ENV=development
APP_NAME=LoopsKey
APP_HOST=localhost
APP_PORT=5700
FRONTEND_URL=http://localhost:3000
APPLICATION_BASE_URL=http://localhost:3000
SUPPORT_EMAIL=support@example.com

# ------------------------------------------------------------------- database
# Required. Every Prisma command fails with P1012 without it.
DATABASE_URL=

# Required. The same database over a DIRECT (non-pooled) connection, used only
# by Prisma migration commands. Through a pooler the migration engine reads an
# empty _prisma_migrations table and reports every migration as unapplied.
# On Neon this is the DATABASE_URL host without the "-pooler" suffix and without
# the pgbouncer/connection_limit/pool_timeout parameters. When Postgres is local
# and unpooled, use the same value as DATABASE_URL.
DIRECT_DATABASE_URL=

# -------------------------------------------------------------------- graphql
GRAPHQL_PLAYGROUND=true
GRAPHQL_SCHEMA_PATH=src/graphql/schema.gql
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------ jwt
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# -------------------------------------------------------------------- cookies
# ACCESS_TOKEN_COOKIE_NAME is honoured on both write and read. Leave blank to
# use the shared default from @loopskey/api-contracts. If set, apps/front must
# be given the same value.
ACCESS_TOKEN_COOKIE_NAME=
REFRESH_TOKEN_COOKIE_NAME=
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=900000
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------ otp
OTP_LENGTH=6
OTP_CODE_CHARSET=0123456789
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=12

# --------------------------------------------- organization account activation
ORGANIZATION_LOGIN_URL=http://localhost:3000/auth/organization
ORGANIZATION_ACTIVATION_URL=http://localhost:3000/auth/organization/activate
ACTIVATION_TOKEN_EXPIRY_MINUTES=60
ACTIVATION_RESEND_COOLDOWN_SECONDS=120
ACTIVATION_MAX_RESENDS_PER_DAY=5

# ---------------------------------------------------------------------- email
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=LoopsKey <notifications@example.com>

# -------------------------------------------------------------------- contact
# Recipient for public Contact Us inquiries. Production value is
# loopskey.dev@gmail.com. Server-side only: never exposed to the client.
CONTACT_RECIPIENT_EMAIL=loopskey.dev@gmail.com
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
CONTACT_MAX_INQUIRIES_PER_EMAIL=3
CONTACT_MAX_INQUIRIES_PER_IP=10
CONTACT_DUPLICATE_WINDOW_MINUTES=5

# ---------------------------------------------------------------- reliability
# How often the outbox processor polls for pending deliveries.
OUTBOX_POLL_INTERVAL_MS=1000

# -------------------------------------------------------------- oauth: google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_CALENDAR_REDIRECT=

# ------------------------------------------------------------ oauth: linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=

# -------------------------------------------------------------- oauth: shared
OAUTH_REDIRECT_URL=
OAUTH_STATE_SECRET=
OAUTH_STATE_COOKIE_NAME=

# -------------------------------------------------------------------- uploads
# Local disk. These directories must be writable, and persistent in any real
# deployment: the database stores only file metadata.
PDU_UPLOAD_DIR=
CERTIFICATE_UPLOAD_DIR=
AVATAR_UPLOAD_DIR=

# -------------------------------------------------------------------- seeding
# Development only. `npm run db:seed --workspace api`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
SEED_TEST_PASSWORD=
SEED_PROFESSIONAL_USERS=5
SEED_PROVIDER_USERS=3
SEED_ORG_USERS=3
SEED_COURSES=20
