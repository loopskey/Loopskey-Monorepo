{
  "components": {
    "schemas": {
      "BudgetPreference": {
        "description": "Cost preference applied to the supplied candidate catalogue.\n\nOnly FREE_ONLY changes which content may be selected: it removes every\ncandidate whose is_free is false. The other three are recorded on the\ndraft and reach the planner as context, but nothing filters on them — so a\nconsumer must not read PREMIUM as \"prefer paid content\", or\nEMPLOYER_SPONSORED as a raised price ceiling.",
        "enum": [
          "FREE_ONLY",
          "MIXED_FREE_AND_PAID",
          "PREMIUM",
          "EMPLOYER_SPONSORED"
        ],
        "title": "BudgetPreference",
        "type": "string"
      },
      "ChatMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "maxLength": 2500,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "type": "object"
      },
      "ChatTurnRequest": {
        "additionalProperties": false,
        "properties": {
          "current_step": {
            "$ref": "#/components/schemas/StepKey"
          },
          "draft": {
            "$ref": "#/components/schemas/DraftState"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "maxItems": 12,
            "title": "History",
            "type": "array"
          },
          "locale": {
            "default": "en",
            "enum": [
              "fa",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "subject_options": {
            "items": {
              "$ref": "#/components/schemas/SubjectOption"
            },
            "maxItems": 100,
            "title": "Subject Options",
            "type": "array"
          },
          "today": {
            "format": "date",
            "title": "Today",
            "type": "string"
          },
          "user_message": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Message"
          }
        },
        "required": [
          "current_step",
          "draft",
          "today"
        ],
        "title": "ChatTurnRequest",
        "type": "object"
      },
      "ChatTurnResponse": {
        "additionalProperties": false,
        "properties": {
          "assistant_message": {
            "maxLength": 1500,
            "minLength": 1,
            "title": "Assistant Message",
            "type": "string"
          },
          "extracted": {
