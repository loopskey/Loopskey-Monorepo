            ],
            "title": "Summary"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "content_id",
          "content_type",
          "title",
          "is_free"
        ],
        "title": "ContentCandidate",
        "type": "object"
      },
      "ContentType": {
        "description": "A deliberate DB-independent mirror of the Backend catalogue enum.",
