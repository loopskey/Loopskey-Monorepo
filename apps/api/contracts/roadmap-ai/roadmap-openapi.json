      "ContentCandidate": {
        "additionalProperties": false,
        "properties": {
          "content_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Content Id",
            "type": "string"
          },
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
          "credits": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,6}|(?=[\\d.]{1,9}0*$)\\d{0,6}\\.\\d{0,2}0*$)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credits"
          },
          "duration_minutes": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Minutes"
          },
          "is_free": {
            "title": "Is Free",
            "type": "boolean"
          },
          "level": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SkillLevel"
              },
              {
                "type": "null"
              }
            ]
          },
