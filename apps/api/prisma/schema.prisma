enum AssociationRequirementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssociationReportingCycle {
  ONE_TIME
  ANNUAL
  MULTI_YEAR
}

enum AssociationAudienceKind {
  ALL_MEMBERS
  GROUP
  SPECIFIC_MEMBERS
}

enum AssociationEvidencePolicy {
  NOT_REQUIRED
  REQUIRED_NO_REVIEW
  REQUIRED_NEEDS_REVIEW
}

model AssociationRequirement {
  id String @id @default(cuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("AssociationRequirementAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  name        String
  description String?

  creditType           CreditType @default(CPD)
  totalRequiredCredits Float      @default(0)
  deadline             DateTime?

  reportingCycle   AssociationReportingCycle @default(ONE_TIME)
  cycleLengthYears Int?

  evidencePolicy AssociationEvidencePolicy @default(NOT_REQUIRED)

  reportingStart DateTime?
  reportingEnd   DateTime?

  submissionOpensAt  DateTime?
  submissionClosesAt DateTime?

  gracePeriodDays     Int     @default(0)
  allowLateSubmission Boolean @default(true)

  remindersEnabled Boolean            @default(false)
  reminderTiming   CPDReminderTiming?

  audienceKind AssociationAudienceKind @default(ALL_MEMBERS)

  status      AssociationRequirementStatus @default(DRAFT)
  publishedAt DateTime?
  archivedAt  DateTime?

  categories       AssociationRequirementCategory[]
  targets          AssociationRequirementTarget[]
  assignments      AssociationRequirementAssignment[]
  learningContents AssociationLearningContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId])
  @@index([associationId, status])
  @@index([deadline])
  @@index([createdAt])
