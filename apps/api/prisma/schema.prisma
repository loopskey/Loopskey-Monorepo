  indicativeCredits Float?

  requirementId String?
  requirement   AssociationRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  status      AssociationLearningContentStatus @default(DRAFT)
  publishedAt DateTime?
  withdrawnAt DateTime?

  audienceKind AssociationAudienceKind               @default(ALL_MEMBERS)
  targets      AssociationLearningContentTarget[]
  recipients   AssociationLearningContentRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId])
  @@index([associationId, status])
  @@index([category])
  @@index([requirementId])
  @@index([contentType, contentId])
}

model AssociationLearningContentTarget {
  id String @id @default(cuid())

  learningContentId String
  learningContent   AssociationLearningContent @relation(fields: [learningContentId], references: [id], onDelete: Cascade)

  kind AssociationAudienceKind

  groupId String?
  group   AssociationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String?
  member   AssociationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([learningContentId, groupId])
  @@unique([learningContentId, memberId])
  @@index([learningContentId])
}

model AssociationLearningContentRecipient {
  id String @id @default(cuid())

  learningContentId String
  learningContent   AssociationLearningContent @relation(fields: [learningContentId], references: [id], onDelete: Cascade)

  memberId String
  member   AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  isTargeted Boolean @default(true)

  announcedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learningContentId, memberId])
  @@index([memberId])
}

enum AssociationLearningContentStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum AssociationLearningExternalType {
  COURSE
  EVENT
  PODCAST
  VIDEO
  ARTICLE
  WEBINAR
  OTHER
}

enum AssociationReportType {
  GROUP_PROGRESS
  MEMBER_PROGRESS
  OVERVIEW_SUMMARY
  MISSING_EVIDENCE
  RENEWAL_READINESS
  CATEGORY_COMPLETION
}

enum AssociationReportFormat {
  PDF
  EXCEL
}

enum AssociationGeneratedReportState {
  READY
  FAILED
  PENDING
  EXPIRED
}

model AssociationGeneratedReport {
  id String @id @default(cuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("AssociationReportRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  reportType AssociationReportType
  format     AssociationReportFormat

  filter     Json
  filterHash String

  locale String @default("en")

  state AssociationGeneratedReportState @default(PENDING)

  storageKey String
  fileName   String
  mimeType   String

  sizeBytes Int?
  rowCount  Int?

  failureReason String?

  readyAt   DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([associationId, createdAt])
  @@index([associationId, state])
  @@index([state, expiresAt])
}

enum AssociationMessageType {
  WELCOME
  CATEGORY_BEHIND
  BEHIND_THRESHOLD
  CERTIFICATE_EXPIRING
  INVITATION
  GROUP_ADDED
  REQUIREMENT_ASSIGNED
  LEARNING_CONTENT_ASSIGNED
}

enum AssociationMessageDeliveryState {
  SENT
  QUEUED
  FAILED
  SKIPPED
}

model AssociationMessageDelivery {
  providerMessageId String?

  id String @id @default(cuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  memberId String
  member   AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  recipientUserId String
  recipientUser   User   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  messageType     AssociationMessageType
  templateVersion Int                    @default(1)

  audience Json

  context Json

  language AppLanguage @default(EN)

  cooldownBucket Int?

  occurrenceKey String? @unique

  state AssociationMessageDeliveryState @default(QUEUED)

  skipReason    String?
  failureReason String?

  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([associationId, memberId, messageType, cooldownBucket])
  @@index([associationId, createdAt])
  @@index([associationId, messageType])
  @@index([memberId])
  @@index([state])
}

// ================ Ingestion ====================
enum IngestionContentKind {
  EVENT
  COURSE
  PODCAST
  YOUTUBE
}

enum IngestionBatchMode {
  FULL
  INCREMENTAL
}

enum IngestionBatchStatus {
  FAILED
  RECEIVED
  COMPLETED
  PROCESSING
}

enum IngestionItemState {
  STALE
  PENDING
  ACCEPTED
  REJECTED
}

enum IngestionReviewReason {
  PLACEHOLDER_CONTENT
  PLACEHOLDER_URL
  PREVIOUSLY_REJECTED
  MISSING_DESCRIPTION
}

model IngestionSource {
  id   String @id @default(cuid())
  slug String @unique

  name String
  kind IngestionContentKind

  isActive    Boolean @default(true)
  autoPublish Boolean @default(false)

  stalenessWindowDays Int?

  fieldMap Json @default("{}")

  apiKeys IngestionApiKey[]
  batches IngestionBatch[]
  items   IngestionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model IngestionApiKey {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  name   String
  prefix String @unique

  secretHash String

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  rateLimit         Int @default(600)
  rateWindowSeconds Int @default(60)

  rateWindowStartedAt DateTime @default(now())
  rateWindowCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}

model IngestionBatch {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  idempotencyKey String

  mode   IngestionBatchMode   @default(INCREMENTAL)
  status IngestionBatchStatus @default(RECEIVED)

  correlationId String?

  receivedCount Int @default(0)
  acceptedCount Int @default(0)
  rejectedCount Int @default(0)

  report Json @default("[]")

  items IngestionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, idempotencyKey])
  @@index([sourceId, createdAt])
}

model IngestionItem {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  batchId String?
  batch   IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  externalId    String
  canonicalUrl  String?
  canonicalHash String

  unmappedFields    String[] @default([])
  imageCandidateUrl String?

  state           IngestionItemState      @default(PENDING)
  rejectionReason String?
  reviewReasons   IngestionReviewReason[] @default([])

  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  catalogId    String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId, state, createdAt, id])
  @@index([state, createdAt, id])
  @@index([catalogId])
  @@index([batchId])
}

enum TelemetryMetric {
  LCP
  INP
  CLS
}

enum TelemetryDevice {
  MOBILE
  DESKTOP
}

enum TelemetryRouteTemplate {
  FAQ
  HOME
  ABOUT
  LEGAL
  CONTACT
  COMPANY
  SUPPORT
  SERVICES
  SOLUTIONS
  TOPIC_HUB
  EVENT_DETAIL
  COURSE_DETAIL
  PODCAST_DETAIL
  YOUTUBE_DETAIL
  CONTENT_CATALOG
  PROVIDER_PROFILE
}

enum TelemetryLocale {
  EN
  FR
  UNKNOWN
}

enum TelemetryConversionEvent {
  REGISTRATION_START
  CATALOG_DETAIL_OPEN
  REGISTRATION_COMPLETED
  EXTERNAL_CONTENT_ACTION
}

enum TelemetryContentKind {
  NONE
  EVENT
  COURSE
  PODCAST
  YOUTUBE
}

enum TelemetryRegistrationRole {
  NONE
  PROVIDER
  PROFESSIONAL
}

enum TelemetryAttribution {
  DIRECT
  SOCIAL
  REFERRAL
  INTERNAL
  UNATTRIBUTED
  ORGANIC_SEARCH
}

enum TelemetryIntakeKind {
  VITAL
  CONVERSION
}

enum TelemetryIntakeOutcome {
  INVALID
  ACCEPTED
  DISABLED
  DUPLICATE
  SAMPLED_OUT
  SINK_FAILED
  RATE_LIMITED
}

model TelemetryVitalBucket {
  day      DateTime               @db.Date
  metric   TelemetryMetric
  device   TelemetryDevice
  template TelemetryRouteTemplate
  locale   TelemetryLocale
  bucket   Int                    @db.SmallInt
  count    Int

  @@id([day, metric, device, template, locale, bucket])
}

model TelemetryConversionDaily {
  day         DateTime                  @db.Date
  event       TelemetryConversionEvent
  contentKind TelemetryContentKind
  role        TelemetryRegistrationRole
  attribution TelemetryAttribution
  locale      TelemetryLocale
  count       Int

  @@id([day, event, contentKind, role, attribution, locale])
}

model TelemetryIntakeDaily {
  day     DateTime               @db.Date
  kind    TelemetryIntakeKind
  outcome TelemetryIntakeOutcome
  count   Int

  @@id([day, kind, outcome])
}

model TelemetryDedupKey {
  key    String   @id
  seenAt DateTime @default(now())

  @@index([seenAt])
}
