  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId String?
  group   AssociationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  memberNumber String?

  status AssociationMemberStatus @default(PENDING_ACTIVATION)

  notes String?

  invitedAt     DateTime  @default(now())
  activatedAt   DateTime?
  deactivatedAt DateTime?

  requirementTargets     AssociationRequirementTarget[]
  requirementAssignments AssociationRequirementAssignment[]
  messageDeliveries      AssociationMessageDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([associationId, userId])
  @@index([associationId])
  @@index([userId])
  @@index([groupId])
  @@index([status])
}

