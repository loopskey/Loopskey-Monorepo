// ================ Ingestion ====================
enum IngestionContentKind {
  COURSE
  EVENT
  PODCAST
  YOUTUBE
}

enum IngestionBatchMode {
  FULL
  INCREMENTAL
}

enum IngestionBatchStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum IngestionItemState {
  PENDING
  ACCEPTED
  REJECTED
  STALE
}

/// One crawler team's stream for one content kind. Deactivating a source stops
/// its keys from authenticating without deleting anything it has submitted.
model IngestionSource {
  id   String @id @default(cuid())
  slug String @unique

  name String
  kind IngestionContentKind

  isActive    Boolean @default(true)
  autoPublish Boolean @default(false)

  /// Null means an item from this source never goes stale on age alone.
  stalenessWindowDays Int?

  /// Field mapping consumed in phase 03. Empty until an administrator sets it.
  fieldMap Json @default("{}")

  apiKeys IngestionApiKey[]
  batches IngestionBatch[]
  items   IngestionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

/// A machine credential for exactly one source.
///
/// `prefix` is public and is the only part safe to display; `secretHash` is an
/// Argon2id hash and the plaintext secret exists only in the issuance response.
/// The rate allowance lives here rather than in memory so it survives a restart
/// and is shared across instances.
model IngestionApiKey {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  name   String
  prefix String @unique

  secretHash String

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  rateLimit         Int @default(600)
  rateWindowSeconds Int @default(60)

  rateWindowStartedAt DateTime @default(now())
  rateWindowCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
}

/// One submission. `(sourceId, idempotencyKey)` is unique, so a retried
/// submission resolves to the batch that already exists instead of a second one.
model IngestionBatch {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  idempotencyKey String

  mode   IngestionBatchMode   @default(INCREMENTAL)
  status IngestionBatchStatus @default(RECEIVED)

  correlationId String?

  receivedCount Int @default(0)
  acceptedCount Int @default(0)
  rejectedCount Int @default(0)

  items IngestionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, idempotencyKey])
  @@index([sourceId, createdAt])
}

/// One crawled entity, identified by `(sourceId, externalId)`.
///
/// There is deliberately no raw-payload column: the crawler's own store is the
/// system of record for what it fetched, and copying it here would duplicate
/// unbounded third-party content of unclear provenance.
model IngestionItem {
  id String @id @default(cuid())

  sourceId String
  source   IngestionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  batchId String?
  batch   IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  externalId   String
  canonicalUrl String?

  /// Hash of the canonical shape, so an unchanged re-submission is detectable
  /// without storing what was submitted.
  canonicalHash String

  unmappedFields String[] @default([])

  state           IngestionItemState @default(PENDING)
  rejectionReason String?

  /// The catalog row this item produced, once phase 03 writes one.
  catalogId String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, externalId])
  @@index([sourceId, state])
  @@index([batchId])
}
