enum RoadmapStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

enum RoadmapEnrollmentStatus {
  ACTIVE
  COMPLETED
  UNENROLLED
}

enum RoadmapSource {
  CATALOG
  GENERATED
}

enum RoadmapDraftStatus {
  READY
  FAILED
  COMPLETED
  COLLECTING
  GENERATING
}

enum RoadmapChatRole {
  SYSTEM
  ASSISTANT
  PROFESSIONAL
}

enum RoadmapDraftStep {
  GOAL
  REVIEW
  CONTEXT
  GOAL_REASON
  TARGET_DATE
  PREFERENCES
  CPD_TRACKING
  CERTIFICATION
  CPD_REQUIREMENTS
}

enum RoadmapStepProgressStatus {
  COMPLETED
  IN_PROGRESS
}

model Roadmap {
  id   String @id @default(cuid())
  slug String @unique

  title       String
  description String
  imageUrl    String?

  category CourseCategory?
  level    CourseLevel     @default(ALL_LEVELS)
  status   RoadmapStatus   @default(PUBLISHED)

  ownerId String?
  owner   User?   @relation("OwnedRoadmaps", fields: [ownerId], references: [id], onDelete: Cascade)

  source RoadmapSource @default(CATALOG)

  estimatedWeeks Int?
  coverageNote   String?

  phases      RoadmapPhase[]
  enrollments RoadmapEnrollment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([title])
  @@index([ownerId])
  @@index([source])
}

model RoadmapPhase {
  id String @id @default(cuid())

  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  estimatedWeeks Int?

  steps RoadmapStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model RoadmapStep {
  id String @id @default(cuid())

  phaseId String
  phase   RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  contentType ContentType?
  contentId   String?

  estimatedMinutes Int?

  progress RoadmapStepProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phaseId, order])
  @@index([phaseId])
  @@index([contentType, contentId])
}

model RoadmapEnrollment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  progress Int                     @default(0)
  status   RoadmapEnrollmentStatus @default(ACTIVE)

  targetDate DateTime?

  draftId String?       @unique
  draft   RoadmapDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  stepProgress RoadmapStepProgress[]

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, roadmapId])
  @@index([userId])
  @@index([roadmapId])
  @@index([status])
}

model RoadmapStepProgress {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   RoadmapEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  stepId String
  step   RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  status RoadmapStepProgressStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, stepId])
  @@index([enrollmentId])
  @@index([stepId])
  @@index([enrollmentId, status])
}

model RoadmapDraft {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      RoadmapDraftStatus @default(COLLECTING)
  currentStep RoadmapDraftStep   @default(GOAL)

  goal       String?
  targetRole String?
  goalReason String?

  context String?

  targetDate DateTime?

  skillLevel       SkillLevel?
  timeCommitment   LearningTimeCommitment?
  budgetPreference LearningBudgetPreference?

  subjects              String[]         @default([])
  preferredFormats      LearningFormat[] @default([])
  preferredContentTypes ContentType[]    @default([])

  cpdEnabled Boolean @default(false)

  certificationId   String?
  certification     Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  certificationName String?

  cpdPlanId String?
  cpdPlan   CPDPlan? @relation(fields: [cpdPlanId], references: [id], onDelete: SetNull)

  requiredCredits  Float?
  completedCredits Float?

  needsClarification Boolean @default(false)
  wasRefused         Boolean @default(false)

  failureReason String?

  messages   RoadmapChatMessage[]
  enrollment RoadmapEnrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([certificationId])
  @@index([cpdPlanId])
}

model RoadmapChatMessage {
  id String @id @default(cuid())

  draftId String
  draft   RoadmapDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  role    RoadmapChatRole
  content String

  stepKey RoadmapDraftStep

  widget Json?

  createdAt DateTime @default(now())

  @@index([draftId, createdAt])
}

// ================ Organization ==================
enum OrganizationMemberStatus {
  ACTIVE
  INACTIVE
}

enum ComplianceCycle {
  ANNUAL
  BIANNUAL
  QUARTERLY
}

enum AssignmentType {
  HARD
  SOFT
}

enum AssignmentStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum AssignmentTargetKind {
  ALL
  ROLE
  MEMBER
  DEPARTMENT
}

model Organization {
  id String @id @default(cuid())

  ownerId String @unique
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name          String
  logoUrl       String?
  description   String?
  country       String?
  industry      String?
  website       String?
  settings      OrganizationSettings?
  departments   OrganizationDepartment[]
  members       OrganizationMember[]
  cpdCategories OrganizationCPDCategory[]
  assignments   OrganizationAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([name])
}

model OrganizationSettings {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  complianceCycle  ComplianceCycle @default(ANNUAL)
  minimumPdu       Float           @default(60)
  strictCompliance Boolean         @default(false)

  complianceAlerts        Boolean @default(true)
  assignmentNotifications Boolean @default(true)
  weeklySummaryReport     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationDepartment {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  isActive    Boolean @default(true)

  members OrganizationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, title])
  @@index([organizationId])
}

model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String?
  department   OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobRole String?
  status  OrganizationMemberStatus @default(ACTIVE)

  completedLearning Int   @default(0)
  pdus              Float @default(0)
  compliance        Float @default(0)

  joinedAt      DateTime  @default(now())
  deactivatedAt DateTime?
  notes         String?

  assignments OrganizationAssignmentRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([departmentId])
  @@index([status])
  @@index([compliance])
}

model OrganizationCPDCategory {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category      PDUCategory
  title         String
  description   String?
  requiredHours Float
  isActive      Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, category])
  @@index([organizationId])
  @@index([category])
  @@index([isActive])
}

model OrganizationAssignment {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedOrgAssignments", fields: [createdById], references: [id], onDelete: Cascade)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  title       String
  description String?

  type   AssignmentType   @default(SOFT)
  status AssignmentStatus @default(ACTIVE)

  targetKind     AssignmentTargetKind @default(ALL)
  departmentId   String?
  targetRole     String?
  targetMemberId String?

  dueDate DateTime?

  recipients OrganizationAssignmentRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([courseId])
  @@index([eventId])
  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@index([createdAt])
}

model OrganizationAssignmentRecipient {
  id String @id @default(cuid())

  assignmentId String
  assignment   OrganizationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  memberId String
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  completedAt DateTime?
  progress    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, memberId])
  @@index([assignmentId])
  @@index([memberId])
  @@index([completedAt])
}

// ================ Association ==================
/// Unmanaged indexes: Association_name_trgm_idx and
/// Association_contactEmail_trgm_idx are pg_trgm GIN indexes created in raw
/// migration SQL, because Prisma cannot express them and reports them as drift.
model Association {
  id String @id @default(cuid())

  ownerId String @unique
  owner   User   @relation("AssociationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name    String
  logoUrl String?

  logoStorageKey String?
  description    String?
  country        String?
  website        String?
  contactEmail   String?

  settings          AssociationSettings?
  groups            AssociationGroup[]
  members           AssociationMember[]
  requirements      AssociationRequirement[]
  learningContents  AssociationLearningContent[]
  generatedReports  AssociationGeneratedReport[]
  messageDeliveries AssociationMessageDelivery[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([name])
}

model AssociationSettings {
  id String @id @default(cuid())

  associationId String      @unique
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  defaultCreditType CreditType @default(CPD)

  onTrackThreshold Int @default(70)

  atRiskThreshold Int @default(40)

  renewalRequiresReviewedEvidence Boolean @default(true)

  complianceReminders Boolean @default(true)
  welcomeMessages     Boolean @default(true)
  weeklyDigest        Boolean @default(true)

  suppressAllEmail Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssociationMemberStatus {
  ACTIVE
  INACTIVE
  PENDING_ACTIVATION
}

model AssociationGroup {
  id String @id @default(cuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  isActive    Boolean @default(true)

  members           AssociationMember[]
  requirementTarget AssociationRequirementTarget[]
  learningContents  AssociationLearningContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([associationId, title])
  @@index([associationId])
}

model AssociationMember {
