generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  PROVIDER
  PROFESSIONAL
  ORGANIZATION
  ASSOCIATION
}

enum UserStatus {
  ACTIVE
  PENDING
  DELETED
  DISABLED
}

enum OtpPurpose {
  SIGNUP
  CHANGE_EMAIL
  RESET_PASSWORD
  EMAIL_VERIFICATION
  ORGANIZATION_ACTIVATION
  ASSOCIATION_ACTIVATION
  ASSOCIATION_MEMBER_INVITE
}

enum NotificationDeliveryStatus {
  NOT_REQUESTED
  PENDING
  SENT
  FAILED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  LINKEDIN
  FACEBOOK
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// =============== User ================
model User {
  id String @id @default(cuid())

  email String? @unique
  phone String? @unique

  passwordHash String?

  firstName String?
  lastName  String?
  fullName  String?

  avatarUrl        String?
  avatarStorageKey String?
  bio              String?

  role   Role       @default(PROFESSIONAL)
  status UserStatus @default(PENDING)

  forcePasswordChange Boolean @default(false)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  passwordChangedAt DateTime?

  lastLoginAt DateTime?

  authAccounts AuthAccount[]
  sessions     AuthSession[]
  otpCodes     OtpCode[]

  professionalProfile ProfessionalProfile?
  providerProfile     ProviderProfile?
  organizationProfile OrganizationProfile?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  organizationAccessRequests OrganizationAccessRequest[]
  reviewedIngestionItems     IngestionItem[]
  courses                    Course[]
  createdCourses             Course[]                    @relation("ProviderCourses")
  events                     Event[]
  createdEvents              Event[]                     @relation("ProviderEvents")
  eventRegistrations         EventRegistration[]         @relation("UserEventRegistrations")
  createdPodcasts            Podcast[]                   @relation("ProviderPodcasts")
  createdYouTubeChannels     YouTubeChannel[]            @relation("ProviderYouTubeChannels")
  youTubeChannels            YouTubeChannel[]
  wishlistItems              WishlistItem[]
  contentEnrollments         ContentEnrollment[]
  contentReviews             ContentReview[]
  carts                      Cart[]
  providerSettings           ProviderSettings?
  providerPublicProfile      ProviderPublicProfile?

  professionalSettings   ProfessionalSettings?
  pduActivities          PDUActivity[]
  pduActivityFiles       PDUActivityFile[]
  pduTargets             PDUTarget[]
  certificates           Certificate[]
  certificateFiles       CertificateFile[]
  professionalCredential ProfessionalCredential[]
  payments               Payment[]
  roadmapEnrollments     RoadmapEnrollment[]
  roadmapDrafts          RoadmapDraft[]
  ownedRoadmaps          Roadmap[]                @relation("OwnedRoadmaps")

  ownedOrganization               Organization?                @relation("OrganizationOwner")
  ownedAssociation                Association?                 @relation("AssociationOwner")
  associationMemberships          AssociationMember[]
  authoredAssociationRequirements AssociationRequirement[]     @relation("AssociationRequirementAuthor")
  authoredAssociationLearning     AssociationLearningContent[] @relation("AssociationLearningContentAuthor")
  requestedAssociationReports     AssociationGeneratedReport[] @relation("AssociationReportRequester")
  associationMessageDeliveries    AssociationMessageDelivery[]
  organizationMemberships         OrganizationMember[]
  createdOrgAssignments           OrganizationAssignment[]     @relation("CreatedOrgAssignments")

  promotionRequests          EventPromotionRequest[]
  reviewedPromotionRequests  EventPromotionRequest[]    @relation("ReviewedPromotionRequests")
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  externalLearningActivities ExternalLearningActivity[]
  calendarEvents             CalendarEvent[]
  cpdPlans                   CPDPlan[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

// ================= Auth =================
model AuthAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider AuthProvider @default(EMAIL)

  providerUserId String?
  providerEmail  String?

  accessToken  String?
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String

  rotationCounter Int @default(0)

  status SessionStatus @default(ACTIVE)

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model OtpCode {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination String
  codeHash    String

  purpose OtpPurpose

  associationMemberId String?
  associationMember   AssociationMember? @relation(fields: [associationMemberId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  resendAfter DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([destination])
  @@index([purpose])
  @@index([expiresAt])
  @@index([codeHash, purpose])
  @@index([associationMemberId])
}

model PendingRegistration {
  id String @id @default(cuid())

  email        String @unique
  fullName     String
  passwordHash String
  role         Role

  otpCodeHash  String
  otpExpiresAt DateTime

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  resendAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([otpExpiresAt])
}

// ================= Profile =================
enum ProfessionalIndustry {
  LEGAL
  OTHER
  FINANCE
  EDUCATION
  MARKETING
  TECHNOLOGY
  HEALTHCARE
  NON_PROFIT
  ENGINEERING
  CONSTRUCTION
  PUBLIC_SECTOR
  MANUFACTURING
}

enum ExperienceRange {
  ONE_TO_TWO_YEARS
  SIX_TO_TEN_YEARS
  LESS_THAN_ONE_YEAR
  SIXTEEN_PLUS_YEARS
  THREE_TO_FIVE_YEARS
  ELEVEN_TO_FIFTEEN_YEARS
}

enum SkillLevel {
  EXPERT
  BEGINNER
  ADVANCED
  INTERMEDIATE
}

enum LearningFormat {
  VIDEO
  COURSE
  WEBINAR
  PODCAST
  ARTICLE
  WORKSHOP
}

enum LearningTimeCommitment {
  ONE_TO_TWO_HOURS
  TWO_TO_THREE_HOURS
  THREE_TO_FIVE_HOURS
  MORE_THAN_FIVE_HOURS
}

enum LearningBudgetPreference {
  FREE_ONLY
  UNDER_100
  HUNDRED_TO_500
  FIVE_HUNDRED_PLUS
}

enum DeliveryFormat {
  ONLINE
  IN_PERSON
  SELF_PACED
  LIVE_COHORT
}

enum ProfessionalGoal {
  GROW_IN_CURRENT_ROLE
  PREPARE_FOR_NEXT_ROLE
  MAINTAIN_CERTIFICATION
  EXPLORE_PROFESSIONAL_PATH
}

model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  linkedInUrl String?
  countryCode String?
  language    AppLanguage?
  timeZone    String?

  profession          String?
  industry            ProfessionalIndustry?
  currentRole         String?
  currentRoleTermId   String?
  currentRoleTerm     ProfileTaxonomyTerm?  @relation("ProfessionalCurrentRole", fields: [currentRoleTermId], references: [id], onDelete: SetNull)
  experienceRange     ExperienceRange?
  workLocation        String?
  professionalSummary String?

  professionalGoal      ProfessionalGoal?
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  onboardingDismissedAt DateTime?

  currentSkillLevel SkillLevel?
  targetSkillLevel  SkillLevel?

  terms ProfessionalProfileTerm[]

  // Learning preferences
  preferredLearningFormats LearningFormat[]          @default([])
  learningTimeCommitment   LearningTimeCommitment?
  learningBudgetPreference LearningBudgetPreference?

  interests String[]
  skills    String[]
  website   String?
  education String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([countryCode])
  @@index([currentRoleTermId])
}

// ========== Professional profile taxonomy ==========
enum ProfileTaxonomyKind {
  ROLE
  SUBJECT
  SKILL_AREA
}

enum ProfileTermUsage {
  MAIN_SKILL
  FAVORITE_SUBJECT
  SKILL_TO_IMPROVE
}

model ProfileTaxonomyGroup {
  id String @id @default(cuid())

  kind ProfileTaxonomyKind
  key  String

  label String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  terms         ProfileTaxonomyTerm[]
  skillMappings ProfileTaxonomyGroupMapping[] @relation("RoleGroupSkillMappings")
  roleMappings  ProfileTaxonomyGroupMapping[] @relation("SkillGroupRoleMappings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
  @@index([kind, isActive, sortOrder])
}

model ProfileTaxonomyGroupMapping {
  id String @id @default(cuid())

  roleGroupId String
  roleGroup   ProfileTaxonomyGroup @relation("RoleGroupSkillMappings", fields: [roleGroupId], references: [id], onDelete: Cascade)

  skillGroupId String
  skillGroup   ProfileTaxonomyGroup @relation("SkillGroupRoleMappings", fields: [skillGroupId], references: [id], onDelete: Cascade)

  priority Int
  version  Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleGroupId, skillGroupId])
  @@index([roleGroupId, isActive, priority])
}

model ProfileTaxonomyTerm {
  id String @id @default(cuid())

  kind ProfileTaxonomyKind
  key  String

  label String

  groupId String
  group   ProfileTaxonomyGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  profileTerms        ProfessionalProfileTerm[]
  currentRoleProfiles ProfessionalProfile[]     @relation("ProfessionalCurrentRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
  @@index([kind, isActive, sortOrder])
  @@index([groupId, isActive, sortOrder])
}

model ProfessionalProfileTerm {
  id String @id @default(cuid())

  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  termId String
  term   ProfileTaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  usage ProfileTermUsage

  createdAt DateTime @default(now())

  @@unique([profileId, termId, usage])
  @@index([profileId, usage])
  @@index([termId])
}

// ========== Professional credentials (general licences) ==========
model ProfessionalCredential {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  issuingOrganization String?
  licenceNumber       String?

  issueDate  DateTime?
  expiryDate DateTime?

  annualCpdHours Float?

  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)

  pduTargetId String?
  pduTarget   PDUTarget? @relation(fields: [pduTargetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, certificationId])
  @@index([userId])
  @@index([pduTargetId])
  @@index([expiryDate])
}

model ProviderProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String?
  website          String?
  logoUrl          String?
  contactEmail     String?
  contactPhone     String?

  isPremium Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationName String
  website          String?
  logoUrl          String?
  contactEmail     String?
  contactPhone     String?

  industry    String?
  memberLimit Int?
  timezone    String?
  country     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============== Org Access Request =============
enum OrganizationAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationType {
  OTHER
  COMPANY
  UNIVERSITY
  GOVERNMENT
  NON_PROFIT
  ASSOCIATION
  TRAINING_PROVIDER
}

model OrganizationAccessRequest {
  id String @id @default(cuid())

  targetRole                    Role             @default(ORGANIZATION)
  representativeFullName        String
  organizationName              String
  workEmail                     String
  organizationType              OrganizationType
  representativeJobRole         String
  expectedLicensedProfessionals Int
  country                       String
  goals                         String

  status OrganizationAccessRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt   DateTime?
  rejectReason String?

  approvedUserId String?

  notificationStatus        NotificationDeliveryStatus @default(NOT_REQUESTED)
  notificationSentAt        DateTime?
  notificationLastAttemptAt DateTime?
  notificationFailureCode   String?

  submissionNotificationStatus        NotificationDeliveryStatus @default(NOT_REQUESTED)
  submissionNotificationSentAt        DateTime?
  submissionNotificationLastAttemptAt DateTime?
  submissionNotificationFailureCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workEmail])
  @@index([status])
  @@index([organizationType])
  @@index([targetRole])
  @@index([createdAt])
  @@index([notificationStatus])
  @@index([submissionNotificationStatus])
}

// ============== Course ===============
enum CourseCategory {
  ACCOUNTING
  AI
  BUSINESS
  CAREER
  CERTIFICATION
  CLOUD
  COMMUNICATION
  COMPLIANCE
  CONSTRUCTION
  CYBERSECURITY
  DATA
  DESIGN
  EDUCATION
  ENGINEERING
  FINANCE
  GENERAL
  HEALTHCARE
  HEALTH_SAFETY
  HUMAN_RESOURCES
  LEADERSHIP
  LEGAL
  MARKETING
  NURSING
  PRODUCT_MANAGEMENT
  PROJECT_MANAGEMENT
  QUALITY
  SALES
  SOFTWARE_DEVELOPMENT
  SUPPLY_CHAIN
  SUSTAINABILITY
  TECHNOLOGY
}

enum CourseLevel {
  BEGINNER
  ADVANCED
  ALL_LEVELS
  INTERMEDIATE
}

enum CourseStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

enum CurriculumLessonType {
  QUIZ
  VIDEO
  ARTICLE
  DOWNLOAD
  ASSIGNMENT
  LIVE_SESSION
}

model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  externalRef String? @unique
  sourceUrl   String?

  title       String
  instructor  String
  imageUrl    String?
  description String

  category CourseCategory
  level    CourseLevel    @default(ALL_LEVELS)
  status   CourseStatus   @default(DRAFT)

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("USD")
  isFree   Boolean  @default(true)

  durationMinutes Int?
  lastUpdatedAt   DateTime @default(now())

  requirements String[] @default([])
  learnings    String[] @default([])

  sourcePlatform String?
  sourceLanguage String?
  rawCategory    String?
  rawLevel       String?
  rawDuration    String?
  crawledAt      DateTime?

  internalCategory  String?
  offersCertificate Boolean?
  creditValue       Float?
  creditSource      String?
  creditConfidence  Float?

  rating        Float @default(0)
  ratingCount   Int   @default(0)
  professionals Int   @default(0)

  isFeatured Boolean @default(false)

  providerId String?
  provider   User?   @relation("ProviderCourses", fields: [providerId], references: [id], onDelete: SetNull)

  curriculumSections      CurriculumSection[]
  organizationAssignments OrganizationAssignment[]

  /// Last change to content a public visitor can see, or to publication
  /// state. Metric writes (views, listeners, ratings, attendees) never move it;
  /// it is the lastmod the public sitemap publishes.
  publicContentUpdatedAt DateTime  @default(now())
  /// Moderation flag set only by an administrator. The page stays publicly
  /// readable but is told not to be indexed and leaves the sitemap.
  excludeFromIndex       Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  user                       User?                      @relation(fields: [userId], references: [id])
  userId                     String?
  externalLearningActivities ExternalLearningActivity[]

  translations CourseTranslation[]
  seoOverrides CourseSeo[]

  @@index([status, category])
  @@index([status, level])
  @@index([providerId])
  @@index([createdAt])
  @@index([title])
}

model CurriculumSection {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int     @default(0)

  lessons CurriculumLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
  @@index([order])
}

model CurriculumLesson {
  id String @id @default(cuid())

  sectionId String
  section   CurriculumSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title           String
  description     String?
  type            CurriculumLessonType @default(VIDEO)
  durationMinutes Int?
  isPreview       Boolean              @default(false)
  order           Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, order])
  @@index([sectionId])
  @@index([type])
  @@index([order])
}

// =============== Events =================
enum EventType {
  OTHER
  COURSE
  WEBINAR
  SEMINAR
  WORKSHOP
  TRAINING
  CONFERENCE
  NETWORKING
}

enum EventDeliveryMode {
  HYBRID
  RECORDED
  IN_PERSON
  LIVE_ONLINE
}

enum EventStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
  CANCELLED
}

enum EventCategory {
  ACCOUNTING
  AI
  BUSINESS
  CAREER
  CERTIFICATION
  CLOUD
  COMMUNICATION
  COMPLIANCE
  CONSTRUCTION
  CYBERSECURITY
  DATA
  DESIGN
  EDUCATION
  ENGINEERING
  FINANCE
  GENERAL
  HEALTHCARE
  HEALTH_SAFETY
  HUMAN_RESOURCES
  LEADERSHIP
  LEGAL
  MARKETING
  NURSING
  PRODUCT_MANAGEMENT
  PROJECT_MANAGEMENT
  QUALITY
  SALES
  SOFTWARE_DEVELOPMENT
  SUPPLY_CHAIN
  SUSTAINABILITY
  TECHNOLOGY
}

enum EventRegistrationStatus {
  ATTENDED
  CANCELED
  COMPLETED
  CANCELLED
  REGISTERED
  NOT_ATTENDED
}

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique
  externalRef String? @unique
  sourceUrl   String?

  title        String
  type         EventType
  deliveryMode EventDeliveryMode
  category     EventCategory
  status       EventStatus       @default(DRAFT)

  imageUrl    String?
  speaker     String?
  organizer   String?
  description String

  startDate DateTime
  endDate   DateTime?
  timezone  String    @default("UTC")

  location  String?
  onlineUrl String?

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("USD")
  isFree   Boolean  @default(true)

  pdu       Float @default(0)
  capacity  Int?
  attendees Int   @default(0)
  views     Int   @default(0)

  rating        Float @default(0)
  averageRating Float @default(0)
  ratingCount   Int   @default(0)

  registrationEnabled Boolean @default(true)

  providerId String?
  provider   User?   @relation("ProviderEvents", fields: [providerId], references: [id], onDelete: SetNull)

  registrations EventRegistration[]

  publicContentUpdatedAt DateTime            @default(now())
  excludeFromIndex       Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?
  user                   User?               @relation(fields: [userId], references: [id])
  userId                 String?
  scheduleItems          EventScheduleItem[]

  specificTopic     String?
  pduCategory       PDUCategory?
  earlyBirdDiscount Float?
  promotionVideoUrl String?

  language AppLanguage @default(EN)
  topic    String?

  thumbnailUrl        String?
  promotionalVideoUrl String?

  earlyBirdDiscountPercent Float?
  earlyBirdEndsAt          DateTime?

  sourcePlatform  String?
  sourceLanguage  String?
  rawType         String?
  rawDeliveryMode String?
  rawCategory     String?
  lastUpdatedAt   DateTime?
  crawledAt       DateTime?

  promotionRequests          EventPromotionRequest[]
  organizationAssignments    OrganizationAssignment[]
  externalLearningActivities ExternalLearningActivity[]

  translations EventTranslation[]
  seoOverrides EventSeo[]

  @@index([status, category])
  @@index([status, deliveryMode])
  @@index([providerId])
  @@index([startDate])
  @@index([createdAt])
  @@index([title])
  @@index([slug])
}

model EventRegistration {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserEventRegistrations", fields: [userId], references: [id], onDelete: Cascade)

  status      EventRegistrationStatus @default(REGISTERED)
  attendedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model EventScheduleItem {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  dayNumber   Int
  startTime   DateTime
  endTime     DateTime
  title       String
  description String?
  speaker     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([dayNumber])
  @@index([startTime])
}

// ============== Calendar ================
enum CalendarEventType {
  EVENT
  OTHER
  COURSE
  WEBINAR
  MEETING
  TRAINING
}

model CalendarEvent {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  type            CalendarEventType @default(OTHER)
  startDate       DateTime
  endDate         DateTime?
  durationMinutes Int?
  notes           String?

  contentType ContentType?
  contentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startDate])
  @@index([contentType, contentId])
}

// ============== Podcast ================
enum PodcastCategory {
  ACCOUNTING
  AI
  BUSINESS
  CAREER
  CERTIFICATION
  CLOUD
  COMMUNICATION
  COMPLIANCE
  CONSTRUCTION
  CYBERSECURITY
  DATA
  DESIGN
  EDUCATION
  ENGINEERING
  FINANCE
  GENERAL
  HEALTHCARE
  HEALTH_SAFETY
  HUMAN_RESOURCES
  LEADERSHIP
  LEGAL
  MARKETING
  NURSING
  PRODUCT_MANAGEMENT
  PROJECT_MANAGEMENT
  QUALITY
  SALES
  SOFTWARE_DEVELOPMENT
  SUPPLY_CHAIN
  SUSTAINABILITY
  TECHNOLOGY
}

enum PodcastStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

model Podcast {
  id          String  @id @default(cuid())
  slug        String  @unique
  externalRef String? @unique
  sourceUrl   String?

  title       String
  host        String
  imageUrl    String?
  description String

  category PodcastCategory
  status   PodcastStatus   @default(DRAFT)

  rating      Float @default(0)
  ratingCount Int   @default(0)
  listeners   Int   @default(0)

  durationMinutes Int?
  episodeCount    Int  @default(0)

  isFeatured Boolean @default(false)

  sourcePlatform String?
  sourceLanguage String?
  rawCategory    String?
  lastUpdatedAt  DateTime?
  crawledAt      DateTime?

  providerId String?
  provider   User?   @relation("ProviderPodcasts", fields: [providerId], references: [id], onDelete: SetNull)

  episodes PodcastEpisode[]

  publicContentUpdatedAt DateTime  @default(now())
  excludeFromIndex       Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  translations PodcastTranslation[]
  seoOverrides PodcastSeo[]

  @@index([status, category])
  @@index([providerId])
  @@index([createdAt])
  @@index([title])
  @@index([slug])
}

model PodcastEpisode {
  id String @id @default(cuid())

  podcastId String
