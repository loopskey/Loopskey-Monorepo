// ================== Roadmap ====================
enum RoadmapStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

enum RoadmapEnrollmentStatus {
  ACTIVE
  COMPLETED
  UNENROLLED
}

enum RoadmapSource {
  CATALOG
  GENERATED
}

enum RoadmapDraftStatus {
  READY
  FAILED
  COMPLETED
  COLLECTING
  GENERATING
}

enum RoadmapChatRole {
  SYSTEM
  ASSISTANT
  PROFESSIONAL
}

enum RoadmapDraftStep {
  GOAL
  REVIEW
  CONTEXT
  GOAL_REASON
  TARGET_DATE
  PREFERENCES
  CPD_TRACKING
  CERTIFICATION
  CPD_REQUIREMENTS
}

enum RoadmapStepProgressStatus {
  COMPLETED
  IN_PROGRESS
}

enum RoadmapMatchTier {
  EXACT
  SIMILAR
  RELATED
  BROAD
}

model Roadmap {
  id   String @id @default(cuid())
  slug String @unique

  title       String
  description String
  imageUrl    String?

  category CourseCategory?
  level    CourseLevel     @default(ALL_LEVELS)
  status   RoadmapStatus   @default(PUBLISHED)

  ownerId String?
  owner   User?   @relation("OwnedRoadmaps", fields: [ownerId], references: [id], onDelete: Cascade)

  source RoadmapSource @default(CATALOG)

  estimatedWeeks Int?
  coverageNote   String?
  matchTier      RoadmapMatchTier?

  phases      RoadmapPhase[]
  enrollments RoadmapEnrollment[]
  editDrafts  RoadmapDraft[]      @relation("RoadmapEditDrafts")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([title])
  @@index([ownerId])
  @@index([source])
}

model RoadmapPhase {
  id String @id @default(cuid())

  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  estimatedWeeks Int?

  steps RoadmapStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model RoadmapStep {
  id String @id @default(cuid())

  phaseId String
  phase   RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  contentType  ContentType?
  contentId    String?
  isCloseMatch Boolean      @default(false)

  estimatedMinutes Int?
  credits          Float?

  progress RoadmapStepProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phaseId, order])
  @@index([phaseId])
  @@index([contentType, contentId])
}

model RoadmapEnrollment {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  progress Int                     @default(0)
  status   RoadmapEnrollmentStatus @default(ACTIVE)

  targetDate DateTime?

  draftId String?       @unique
  draft   RoadmapDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  stepProgress RoadmapStepProgress[]

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, roadmapId])
  @@index([userId])
  @@index([roadmapId])
  @@index([status])
}

model RoadmapStepProgress {
  id String @id @default(cuid())

  enrollmentId String
  enrollment   RoadmapEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  stepId String
  step   RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  status RoadmapStepProgressStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, stepId])
  @@index([enrollmentId])
  @@index([stepId])
  @@index([enrollmentId, status])
}

/// Unmanaged partial unique index: RoadmapDraft_open_edit_key on (replacesRoadmapId) WHERE replacesRoadmapId IS NOT NULL AND status IN (COLLECTING, READY, GENERATING, FAILED).
model RoadmapDraft {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  replacesRoadmapId String?
  replacesRoadmap   Roadmap? @relation("RoadmapEditDrafts", fields: [replacesRoadmapId], references: [id], onDelete: SetNull)

  status      RoadmapDraftStatus @default(COLLECTING)
  currentStep RoadmapDraftStep   @default(GOAL)

  goal       String?
  targetRole String?
  goalReason String?

  context String?

  targetDate DateTime?

  skillLevel       SkillLevel?
  timeCommitment   LearningTimeCommitment?
  budgetPreference LearningBudgetPreference?

  subjects                 String[]         @default([])
  preferredFormats         LearningFormat[] @default([])
  preferredContentTypes    ContentType[]    @default([])
  preferredDeliveryFormats DeliveryFormat[] @default([])

  cpdEnabled  Boolean @default(false)
  cpdAnswered Boolean @default(false)

  certificationId   String?
  certification     Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  certificationName String?

  cpdPlanId String?
  cpdPlan   CPDPlan? @relation(fields: [cpdPlanId], references: [id], onDelete: SetNull)

  requiredCredits  Float?
  completedCredits Float?

  needsClarification Boolean @default(false)
  wasRefused         Boolean @default(false)

  failureReason String?

  messages   RoadmapChatMessage[]
  enrollment RoadmapEnrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([certificationId])
  @@index([cpdPlanId])
  @@index([replacesRoadmapId])
}

model RoadmapChatMessage {
  id String @id @default(cuid())

  draftId String
  draft   RoadmapDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  role    RoadmapChatRole
  content String

  stepKey RoadmapDraftStep

  widget Json?

  createdAt DateTime @default(now())

  @@index([draftId, createdAt])
}

