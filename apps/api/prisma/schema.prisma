  mappedCategory  PDUCategory
  requiredCredits Float       @default(0)
  order           Int         @default(0)

  attributions AssociationCreditAttribution[]

  @@unique([requirementId, name])
  @@unique([requirementId, mappedCategory])
  @@index([requirementId])
}

model AssociationRequirementTarget {
  id String @id @default(cuid())

  requirementId String
  requirement   AssociationRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  kind AssociationAudienceKind

  groupId String?
  group   AssociationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String?
  member   AssociationMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([requirementId, groupId])
  @@unique([requirementId, memberId])
  @@index([requirementId])
}

model AssociationRequirementAssignment {
  id String @id @default(cuid())

  requirementId String
  requirement   AssociationRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  memberId String
  member   AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  cycleStart DateTime
  cycleEnd   DateTime?
  dueDate    DateTime?

  isTargeted Boolean @default(true)

  recordedCredits     Float                     @default(0)
  completedCredits    Float                     @default(0)
  percent             Float                     @default(0)
  band                AssociationComplianceBand @default(NOT_STARTED)
  awaitingReviewCount Int                       @default(0)
  isMissingEvidence   Boolean                   @default(false)
  computedAt          DateTime?

  attributions AssociationCreditAttribution[]

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([requirementId, memberId, cycleStart])
  @@index([memberId])
  @@index([dueDate])
  @@index([requirementId])
  @@index([band])
}

enum AssociationAttributionState {
  COUNTED
  AWAITING_REVIEW
  REJECTED
}

enum AssociationComplianceBand {
