  creditedAmount Float                       @default(0)
  activityDate   DateTime
  isLate         Boolean                     @default(false)
  state          AssociationAttributionState @default(COUNTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, activityId])
  @@index([assignmentId])
  @@index([activityId])
  @@index([categoryId])
  @@index([state])
  @@index([assignmentId, createdAt])
