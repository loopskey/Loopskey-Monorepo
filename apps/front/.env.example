# Loopskey frontend — environment template
#
# Copy to `.env` and fill in. Only NEXT_PUBLIC_* values reach the browser;
# never put a secret behind that prefix.

# GraphQL endpoint.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5700/graphql

# REST origin used for avatar, evidence, association logo/file, and report
# download upload/download clients. If unset, it falls back to the origin of
# NEXT_PUBLIC_GRAPHQL_URL (stripping `/graphql`), so existing deployments that
# co-host REST and GraphQL keep working without setting this. Set it
# explicitly whenever REST and GraphQL are served from different origins. Must
# be an absolute http(s) origin with no path.
NEXT_PUBLIC_API_URL=http://localhost:5700

# Public site origin, used as the metadata base so Open Graph and social-card
# URLs resolve to absolute links. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used by the session helpers and the role-routing proxy.
SESSION_SECRET_KEY=

# Must match the API's JWT_ACCESS_SECRET — the proxy verifies the access token
# locally to decide role routing before any request reaches the API.
JWT_ACCESS_SECRET=

# Optional. Leave blank to use the shared default from @loopskey/api-contracts.
# If set, it must match the API's value or authentication breaks.
ACCESS_TOKEN_COOKIE_NAME=

# Optional. Only needed when the licensed NEAT gradient effect is enabled.
NEXT_PUBLIC_NEAT_LICENSE_KEY=
