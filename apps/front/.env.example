# Loopskey frontend — environment template
#
# Copy to `.env` and fill in. Only NEXT_PUBLIC_* values reach the browser;
# never put a secret behind that prefix.

# GraphQL endpoint. The REST origin used for evidence upload and download is
# derived from this by stripping `/graphql`, so the two must stay co-hosted.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5700/graphql

# Server-only. Used by the session helpers and the role-routing proxy.
SESSION_SECRET_KEY=

# Must match the API's JWT_ACCESS_SECRET — the proxy verifies the access token
# locally to decide role routing before any request reaches the API.
JWT_ACCESS_SECRET=

# Optional. Leave blank to use the shared default from @loopskey/api-contracts.
# If set, it must match the API's value or authentication breaks.
ACCESS_TOKEN_COOKIE_NAME=

# Optional. Only needed when the licensed NEAT gradient effect is enabled.
NEXT_PUBLIC_NEAT_LICENSE_KEY=
