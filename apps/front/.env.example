# Loopskey frontend — environment template
#
# Copy to `.env` and fill in. Only NEXT_PUBLIC_* values reach the browser;
# never put a secret behind that prefix.

# GraphQL endpoint.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:5700/graphql

# Server-only GraphQL endpoint the Next.js server uses to render public content
# pages (courses, events, podcasts, YouTube channels) and social cards. Never
# sent to the browser. Optional: when unset, NEXT_PUBLIC_GRAPHQL_URL is used,
# which is correct for local development. In a container set it to the API
# address reachable from the frontend container, for example
# http://api:5700/graphql. Requests carry no cookies and time out after 4s.
# GRAPHQL_SERVER_URL=http://localhost:5700/graphql

# REST origin used for avatar, evidence, association logo/file, and report
# download upload/download clients. If unset, it falls back to the origin of
# NEXT_PUBLIC_GRAPHQL_URL (stripping `/graphql`), so existing deployments that
# co-host REST and GraphQL keep working without setting this. Set it
# explicitly whenever REST and GraphQL are served from different origins. Must
# be an absolute http(s) origin with no path.
NEXT_PUBLIC_API_URL=http://localhost:5700

# Canonical public site origin. Every canonical, Open Graph, Twitter and
# social-card URL is built from it, and nothing is ever derived from the
# incoming Host header. It must be a bare absolute origin: no path, no query
# string, no username or password. Baked in at build time, so the frontend
# image must be rebuilt after changing it.
#
# Only DEPLOYMENT_ENV=development may use an http or localhost origin, and only
# development falls back to http://localhost:3000 when this is unset. Every
# other deployment environment refuses to build or boot without an https
# origin on the public hostname.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only indexing and configuration policy, deliberately separate from
# NODE_ENV: a production build served as staging still has to be unindexable.
# One of development, ci, preview, staging or production. Anything other than
# production emits noindex for every route and a disallow-all robots.txt.
# Read at build time, so a staging artifact must be rebuilt — never relabelled
# — before it is promoted to production.
DEPLOYMENT_ENV=development

# Optional. Comma-separated hosts that are redirected to NEXT_PUBLIC_SITE_URL,
# for example an apex host when the canonical origin is the www host. Bare
# hosts only, optionally with a port, and never the canonical host itself.
# Only these configured hosts are ever normalized; an unknown Host is never
# trusted and never reaches a canonical or social URL.
SITE_CANONICAL_HOST_ALIASES=

# Optional. Set to true only when the trusted ingress terminates TLS and sets
# x-forwarded-proto, to redirect forwarded http requests to the https origin.
# Leave false when the ingress already redirects, otherwise a proxy that
# forwards the wrong scheme can produce a redirect loop. See the reverse-proxy
# section of the root README.
SITE_HTTPS_REDIRECT=false

# Server-only. Used by the session helpers and the role-routing proxy.
SESSION_SECRET_KEY=

# Must match the API's JWT_ACCESS_SECRET — the proxy verifies the access token
# locally to decide role routing before any request reaches the API.
JWT_ACCESS_SECRET=

# Optional. Leave blank to use the shared default from @loopskey/api-contracts.
# If set, it must match the API's value or authentication breaks.
ACCESS_TOKEN_COOKIE_NAME=

# Optional. Only needed when the licensed NEAT gradient effect is enabled.
NEXT_PUBLIC_NEAT_LICENSE_KEY=
