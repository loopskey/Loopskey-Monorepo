{
  "version": 1,
  "limits": {
    "maxRequests": 120,
    "timeoutMs": 10000,
    "concurrency": 4,
    "maxSitemapShards": 10,
    "maxBodyBytes": 2097152,
    "sitemapUrlMax": 50000
  },
  "contentFixtures": {
    "courseSlug": null,
    "eventSlug": null,
    "podcastSlug": null,
    "youtubeSlug": null,
    "topicSlug": null,
    "providerSlug": null,
    "courseSlugWithoutFrench": null,
    "historicCourseSlug": null
  },
  "discoverFixtures": {
    "smoke": { "courseSlug": "/courses/" }
  },
  "profiles": {
    "smoke": [
      "home-en",
      "home-fr",
      "catalog-en",
      "smoke-course",
      "private-auth",
      "robots",
      "sitemap"
    ],
    "hosts": [
      "locale-prefix",
      "canonical-host",
      "hostile-host-home",
      "hostile-host-private",
      "alias-home",
      "alias-query",
      "alias-locale-prefix",
      "alias-french",
      "alias-encoded",
      "alias-hostile-forwarded-host",
      "forwarded-http",
      "forwarded-http-locale-prefix"
    ],
    "static": [
      "home-en",
      "home-fr",
      "about-en",
      "about-fr",
      "contact-en",
      "faq-en",
      "terms-en",
      "privacy-en",
      "private-auth",
      "private-dashboard",
      "unknown-en",
      "unknown-fr",
      "robots"
    ],
    "full": [
      "home-en",
      "home-fr",
      "about-en",
      "about-fr",
      "contact-en",
      "faq-en",
      "terms-en",
      "privacy-en",
      "private-auth",
      "private-dashboard",
      "unknown-en",
      "unknown-fr",
      "catalog-en",
      "catalog-fr",
      "course-en",
      "course-fr",
      "event-en",
      "podcast-en",
      "youtube-en",
      "topic-en",
      "provider-en",
      "provider-fr-absent",
      "course-missing-french",
      "course-unknown-slug",
      "course-historic-slug",
      "robots",
      "sitemap"
    ]
  },
  "routes": [
    {
      "id": "locale-prefix",
      "path": "/en/about",
      "kind": "redirect",
      "status": 308,
      "redirectTo": "/about"
    },
    {
      "id": "canonical-host",
      "path": "/about",
      "kind": "page",
      "locale": "en",
      "request": { "host": "{canonicalHost}" },
      "alternates": {
        "en": "/about",
        "fr": "/fr/about",
        "x-default": "/about"
      },
      "jsonLdTypes": ["AboutPage"]
    },
    {
      "id": "hostile-host-home",
      "path": "/",
      "kind": "page",
      "locale": "en",
      "request": {
        "host": "attacker.invalid",
        "headers": {
          "x-forwarded-host": "attacker.invalid",
          "x-forwarded-proto": "https"
        }
      },
      "alternates": { "en": "/", "fr": "/fr", "x-default": "/" },
      "jsonLdTypes": ["Organization", "WebSite", "WebPage"]
    },
    {
      "id": "hostile-host-private",
      "path": "/dashboard/professional",
      "kind": "private",
      "indexable": false,
      "status": [200, 307, 308, 401, 403, 404],
      "request": {
        "host": "attacker.invalid",
        "headers": {
          "x-forwarded-host": "attacker.invalid",
          "x-forwarded-proto": "https"
        }
      }
    },
    {
      "id": "alias-home",
      "path": "/",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": { "host": "{aliasHost}" },
      "location": "{siteOrigin}/"
    },
    {
      "id": "alias-query",
      "path": "/content?q=project%20manager&cursor=audit%2F1&lang=fr",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": { "host": "{aliasHost}" },
      "location": "{siteOrigin}/content?q=project%20manager&cursor=audit%2F1&lang=fr"
    },
    {
      "id": "alias-locale-prefix",
      "path": "/en/about?ref=audit",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": { "host": "{aliasHost}" },
      "location": "{siteOrigin}/about?ref=audit"
    },
    {
      "id": "alias-french",
      "path": "/fr/about",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": { "host": "{aliasHost}" },
      "location": "{siteOrigin}/fr/about"
    },
    {
      "id": "alias-encoded",
      "path": "/courses/caf%C3%A9-seo-audit%20x",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": { "host": "{aliasHost}" },
      "location": "{siteOrigin}/courses/caf%C3%A9-seo-audit%20x"
    },
    {
      "id": "alias-hostile-forwarded-host",
      "path": "/about",
      "kind": "redirect",
      "status": 308,
      "requires": ["aliasHost"],
      "request": {
        "host": "{aliasHost}",
        "headers": { "x-forwarded-host": "attacker.invalid" }
      },
      "location": "{siteOrigin}/about"
    },
    {
      "id": "forwarded-http",
      "path": "/about?ref=audit",
      "kind": "redirect",
      "status": 308,
      "requires": ["httpsRedirect"],
      "request": {
        "host": "{canonicalHost}",
        "headers": { "x-forwarded-proto": "http" }
      },
      "location": "{siteOrigin}/about?ref=audit"
    },
    {
      "id": "forwarded-http-locale-prefix",
      "path": "/en/about",
      "kind": "redirect",
      "status": 308,
      "requires": ["httpsRedirect"],
      "request": {
        "host": "{canonicalHost}",
        "headers": { "x-forwarded-proto": "http" }
      },
      "location": "{siteOrigin}/about"
    },
    {
      "id": "home-en",
      "path": "/",
      "kind": "page",
      "locale": "en",
      "alternates": { "en": "/", "fr": "/fr", "x-default": "/" },
      "jsonLdTypes": ["Organization", "WebSite", "WebPage"]
    },
    {
      "id": "home-fr",
      "path": "/fr",
      "kind": "page",
      "locale": "fr",
      "alternates": { "en": "/", "fr": "/fr", "x-default": "/" },
      "jsonLdTypes": ["Organization", "WebSite", "WebPage"]
    },
    {
      "id": "about-en",
      "path": "/about",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/about",
        "fr": "/fr/about",
        "x-default": "/about"
      },
      "jsonLdTypes": ["AboutPage"]
    },
    {
      "id": "about-fr",
      "path": "/fr/about",
      "kind": "page",
      "locale": "fr",
      "alternates": {
        "en": "/about",
        "fr": "/fr/about",
        "x-default": "/about"
      },
      "jsonLdTypes": ["AboutPage"]
    },
    {
      "id": "contact-en",
      "path": "/contact",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/contact",
        "fr": "/fr/contact",
        "x-default": "/contact"
      }
    },
    {
      "id": "faq-en",
      "path": "/faq",
      "kind": "page",
      "locale": "en",
      "alternates": { "en": "/faq", "fr": "/fr/faq", "x-default": "/faq" }
    },
    {
      "id": "terms-en",
      "path": "/terms",
      "kind": "page",
      "locale": "en",
      "alternates": { "en": "/terms", "fr": "/fr/terms", "x-default": "/terms" }
    },
    {
      "id": "privacy-en",
      "path": "/privacy-policy",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/privacy-policy",
        "fr": "/fr/privacy-policy",
        "x-default": "/privacy-policy"
      }
    },
    {
      "id": "private-auth",
      "path": "/auth/professional",
      "kind": "private",
      "indexable": false,
      "status": [200, 307, 308]
    },
    {
      "id": "private-dashboard",
      "path": "/dashboard",
      "kind": "private",
      "indexable": false,
      "status": [200, 307, 308, 401, 403, 404]
    },
    {
      "id": "unknown-en",
      "path": "/this-page-does-not-exist-seo-audit",
      "kind": "missing",
      "indexable": false,
      "status": 404
    },
    {
      "id": "unknown-fr",
      "path": "/fr/this-page-does-not-exist-seo-audit",
      "kind": "missing",
      "indexable": false,
      "status": 404
    },
    {
      "id": "catalog-en",
      "path": "/content",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/content",
        "fr": "/fr/content",
        "x-default": "/content"
      }
    },
    {
      "id": "catalog-fr",
      "path": "/fr/content",
      "kind": "page",
      "locale": "fr",
      "alternates": {
        "en": "/content",
        "fr": "/fr/content",
        "x-default": "/content"
      }
    },
    {
      "id": "course-en",
      "path": "/courses/{courseSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/courses/{courseSlug}",
        "fr": "/fr/courses/{courseSlug}",
        "x-default": "/courses/{courseSlug}"
      },
      "jsonLdTypes": ["Course"]
    },
    {
      "id": "smoke-course",
      "path": "/courses/{courseSlug}",
      "kind": "page",
      "locale": "en",
      "jsonLdTypes": ["Course"]
    },
    {
      "id": "course-fr",
      "path": "/fr/courses/{courseSlug}",
      "kind": "page",
      "locale": "fr",
      "alternates": {
        "en": "/courses/{courseSlug}",
        "fr": "/fr/courses/{courseSlug}",
        "x-default": "/courses/{courseSlug}"
      },
      "jsonLdTypes": ["Course"]
    },
    {
      "id": "event-en",
      "path": "/events/{eventSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/events/{eventSlug}",
        "fr": "/fr/events/{eventSlug}",
        "x-default": "/events/{eventSlug}"
      },
      "jsonLdTypes": ["Event"]
    },
    {
      "id": "podcast-en",
      "path": "/podcasts/{podcastSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/podcasts/{podcastSlug}",
        "fr": "/fr/podcasts/{podcastSlug}",
        "x-default": "/podcasts/{podcastSlug}"
      },
      "jsonLdTypes": ["PodcastSeries"]
    },
    {
      "id": "youtube-en",
      "path": "/youtube/{youtubeSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": {
        "en": "/youtube/{youtubeSlug}",
        "fr": "/fr/youtube/{youtubeSlug}",
        "x-default": "/youtube/{youtubeSlug}"
      }
    },
    {
      "id": "topic-en",
      "path": "/topics/{topicSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": "none",
      "jsonLdTypes": ["CollectionPage"]
    },
    {
      "id": "provider-en",
      "path": "/providers/{providerSlug}",
      "kind": "page",
      "locale": "en",
      "alternates": "none",
      "jsonLdTypes": ["Organization"]
    },
    {
      "id": "provider-fr-absent",
      "path": "/fr/providers/{providerSlug}",
      "kind": "missing",
      "indexable": false,
      "status": 404
    },
    {
      "id": "course-missing-french",
      "path": "/fr/courses/{courseSlugWithoutFrench}",
      "kind": "missing",
      "indexable": false,
      "status": 404
    },
    {
      "id": "course-unknown-slug",
      "path": "/courses/this-course-does-not-exist-seo-audit",
      "kind": "missing",
      "indexable": false,
      "status": 404
    },
    {
      "id": "course-historic-slug",
      "path": "/courses/{historicCourseSlug}",
      "kind": "redirect",
      "status": 308,
      "redirectTo": "/courses/{courseSlug}"
    }
  ]
}
