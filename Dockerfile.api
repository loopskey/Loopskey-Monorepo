# syntax=docker/dockerfile:1

# Stage 1: reduce the monorepo to only what the `api` workspace needs — its own
# source, packages/api-contracts (its one internal dependency), and a lockfile
# scoped to their combined dependency graph. Without this step the next stage
# installs from the full root lockfile and inherits every workspace's hoisted
# node_modules, apps/front's alone (next, react, tailwindcss, radix-ui, three,
# ...) included, even though the API process never imports any of it.
FROM node:22-bookworm-slim AS pruner
WORKDIR /app
# Pinned to match the root "turbo" devDependency; bump both together.
RUN npm install -g turbo@2.5.4
COPY . .
RUN turbo prune api --docker

FROM node:22-bookworm-slim AS builder
WORKDIR /app
# The pruned package.json/package-lock.json first, so `npm ci` is cached and
# only reruns when a dependency actually changes, not on every source edit.
COPY --from=pruner /app/out/json/ .
RUN npm ci
COPY --from=pruner /app/out/full/ .
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
    && npm run build --workspace @loopskey/api-contracts \
    && npm run build --workspace api

FROM node:22-bookworm-slim AS runner
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    APP_HOST=0.0.0.0 \
    APP_PORT=5700 \
    GRAPHQL_SCHEMA_PATH=dist/src/graphql/schema.gql
# Keep the builder dependency tree because the Prisma migration CLI is required
# at container startup. The application itself still runs compiled JavaScript.
# This is the pruned tree from the stage above — apps/api and packages/
# api-contracts only, never apps/front's.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages/api-contracts/package.json ./packages/api-contracts/package.json
COPY --from=builder /app/packages/eslint-config/package.json ./packages/eslint-config/package.json
COPY --from=builder /app/packages/typescript-config/package.json ./packages/typescript-config/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/packages/api-contracts/dist ./packages/api-contracts/dist
# Create the upload namespaces before chown so they exist, owned by node, in the
# image itself. Without this, a freshly created uploads_data volume is mounted
# over an absent directory and Docker makes the mount point root-owned, and
# every LocalObjectStorageAdapter write fails with EACCES under the non-root
# user below. An already-populated volume from an earlier image is unaffected
# by this rebuild — its existing ownership on the host must be fixed once with
# `docker compose exec -u root api chown -R node:node /app/uploads`.
RUN mkdir -p /app/uploads/avatars /app/uploads/certificates /app/uploads/pdu \
             /app/uploads/logos /app/uploads/reports /app/uploads/content \
    && chown -R node:node /app
USER node
EXPOSE 5700
CMD ["sh", "-c", "DB_PASSWORD_ENCODED=$(node -p \"encodeURIComponent(process.env.POSTGRES_PASSWORD)\") && export DATABASE_URL=postgresql://${POSTGRES_USER}:${DB_PASSWORD_ENCODED}@db:5432/${POSTGRES_DB} DIRECT_DATABASE_URL=postgresql://${POSTGRES_USER}:${DB_PASSWORD_ENCODED}@db:5432/${POSTGRES_DB} && npx prisma migrate deploy --schema apps/api/prisma/schema.prisma && node apps/api/dist/src/main.js"]
